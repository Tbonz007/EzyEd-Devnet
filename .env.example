# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_channel_id

# Server
PORT=3000

# Solana wallet being watched
WATCHED_WALLET=Auc3HdZdqUAVhuyLLGG6AJHsSeepgotTNTaoHD76e1oN

# Which Solana cluster this deployment targets: devnet | mainnet-beta
SOLANA_CLUSTER=devnet

# Helius (devnet webhook target - get key at helius.dev)
HELIUS_API_KEY=your_helius_api_key

# Optional: a shared secret you also put in the Helius webhook's auth header,
# so you can verify inbound requests actually came from Helius.
HELIUS_WEBHOOK_SECRET=choose_a_random_string
